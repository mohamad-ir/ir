# ------------------------------------------------------------------
# Application configuration. The web installer (/install) fills in the
# database and URL values automatically; you can also edit them here.
# ------------------------------------------------------------------
APP_NAME="OCT Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# URL of the administration dashboard (e.g. a less predictable value like "studio")
ADMIN_PATH=admin

# Optional token for the /cron/{token} web-cron fallback
CRON_TOKEN=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Email can also be configured in the dashboard (Settings › Email & newsletter)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Absolute path of the uploads folder. Set automatically by the installer when the
# site is served from public_html with the application outside the web root.
MEDIA_ROOT=
